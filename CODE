-- Tenta da mais forte pra mais fraca e CONFERE se pegou: se o servidor
-- recusar, a gente cai pra proxima em vez de achar que deu certo.
local function equiparMelhorVara()
    local lista = varasQueTenho()
    if #lista == 0 then return nil, 0 end
    for _, v in ipairs(lista) do
        if varaAtual() == v.nome then
            equiparVara()
            return v.nome, v.poder
        end
        pcall(function() Events.EquipFishingRod:InvokeServer(v.nome) end)
        task.wait(0.8)
        if varaAtual() == v.nome then
            equiparVara()
            return v.nome, v.poder
        end
    end
    equiparVara()
    return varaAtual(), poderAtual()
end

-- devolve: conseguiu, mensagem
local function irPara(ilha)
    local h = hrp()
    if not h then return false, "sem personagem" end
    if pescando() then recolher() end
    local giro = h.CFrame - h.CFrame.Position
    h.CFrame = CFrame.new(ilha.pos) * giro
    h.AssemblyLinearVelocity = Vector3.zero
    S.anguloBom = nil   -- outra ilha, outra direcao de agua

    -- a parte que importa: a vara aguenta essa agua?
    local nome, poder = melhorVara()
    if nome and poderAtual() < ilha.poder and poder >= ilha.poder then
        equiparMelhorVara()
        nome, poder = varaAtual(), poderAtual()
    else
        poder = poderAtual()
        nome = varaAtual()
    end
    if poder < ilha.poder then
        return true, ("%s · precisa Power %d\nsua %s tem %d — o lance vai ser recusado")
            :format(ilha.agua, ilha.poder, nome ~= "" and nome or "vara", poder)
    end
    return true, ("%s · Power %d\n%s (%d) da conta\nloja: %s")
        :format(ilha.agua, ilha.poder, nome, poder, ilha.loja)
end

