-- CICLO DA PESCA
--------------------------------------------------------------------
local function volta()
    -- venda automatica antes de encher
    if S.autoVender and nInv() >= math.min(S.limiteVenda, limiteInv()) then
        S.estado = "vendendo"
        venderTudo()
    end
    if not equiparVara() then
        S.estado = "sem vara na mao"
        task.wait(2)
        return
    end
    if pescando() then recolher() end

    S.estado = "lancando"
    if not lancar() then
        -- Antes de culpar a posicao, olha o Power: agua forte com vara
        -- fraca da exatamente o mesmo sintoma (o lance volta sozinho).
        local h = hrp()
        local exig, agua = nil, nil
        if h then
            local oc = workspace:FindFirstChild("Ocean")
            if oc then
                for _, w in ipairs(oc:GetChildren()) do
                    if w:IsA("BasePart") and w.Name == "Water" then
                        local rel = w.CFrame:PointToObjectSpace(h.Position)
                        local meio = w.Size / 2
                        if math.abs(rel.X) <= meio.X and math.abs(rel.Z) <= meio.Z then
                            exig = w:GetAttribute("PowerRequired")
                            agua = w:GetAttribute("WaterType")
                            break
                        end
                    end
                end
            end
        end
        if exig and poderAtual() < exig then
            S.estado = ("vara fraca: %s pede %d, a sua tem %d")
                :format(tostring(agua), exig, poderAtual())
        else
            S.estado = "nenhum lado com agua - chegue no pier"
        end
        task.wait(3)
        return
    end

    S.estado = "esperando morder"
    emMinigame = false
    local antes = nInv()
    local limite = os.clock() + 45
    while os.clock() < limite and souAtual() and S.pescar do
        task.wait(0.3)
        if emMinigame then break end
        if not pescando() then break end
    end

    if emMinigame then
        local fim = os.clock() + 40
        while os.clock() < fim and souAtual() and S.pescar do
            task.wait(0.3)
            usarSkills()
            local fid = LocalPlayer:GetAttribute("FishID")
            local peixes = workspace:FindFirstChild("Fishes")
            local nv = fid and peixes and peixes:FindFirstChild(fid)
            local c = char()
            if not nv and not (c and c:GetAttribute("Minigame")) then break end
        end
        soltarBarra()
        emMinigame = false
        task.wait(1.2)
        local depois = nInv()
        if depois > antes then
            S.peixes = S.peixes + (depois - antes)
            S.estado = "peixe no bolso"
        else
            S.estado = "escapou"
        end
    end
    recolher()
end

task.spawn(function()
    while souAtual() do
        if S.pescar then
            local ok, err = pcall(volta)
            if not ok then S.estado = "erro: " .. tostring(err) task.wait(1.5) end
        else
            task.wait(0.4)
        end
        task.wait(0.2)
    end
    soltarBarra()
end)

