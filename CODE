-- Power de uma vara, lido do proprio jogo (nada chumbado)
local cachePoder = {}
local function poderDaVara(nome)
    if not nome or nome == "" then return 0 end
    if cachePoder[nome] ~= nil then return cachePoder[nome] end
    local inv = RS:FindFirstChild("Info")
    inv = inv and inv:FindFirstChild("Inventory")
    local m = inv and inv:FindFirstChild(nome)
    local p = 0
    if m and m:IsA("ModuleScript") then
        local ok, t = pcall(require, m)
        if ok and type(t) == "table" then
            p = tonumber(t.Power or (type(t.Stats) == "table" and t.Stats.Power)) or 0
        end
    end
    cachePoder[nome] = p
    return p
end

local function varaAtual()
    local d = meusDados()
    return (d and d:FindFirstChild("FishingRod")) and d.FishingRod.Value or ""
end

local function poderAtual() return poderDaVara(varaAtual()) end

-- CUIDADO: FishingRodInventory e o CATALOGO inteiro do jogo (39 varas),
-- nao o que voce tem. Quem diz se e sua e o BoolValue "Owned" dentro
-- de cada pasta. Sem esse filtro o painel tenta equipar uma Maoshan
-- Rod que voce nao tem e o servidor recusa em silencio.
local function varasQueTenho()
    local d = meusDados()
    local f = d and d:FindFirstChild("FishingRodInventory")
    local lista = {}
    if not f then return lista end
    for _, v in ipairs(f:GetChildren()) do
        local o = v:FindFirstChild("Owned")
        if o and o.Value == true then
            lista[#lista + 1] = { nome = v.Name, poder = poderDaVara(v.Name) }
        end
    end
    table.sort(lista, function(a, b) return a.poder > b.poder end)
    return lista
end

local function melhorVara()
    local l = varasQueTenho()
    if #l == 0 then return nil, 0 end
    return l[1].nome, l[1].poder
end

local function temVara()
    local c = char()
    return c and c:GetAttribute("Type") == "Fishing Rod"
end
local function equiparVara()
    if temVara() then return true end
    for _ = 1, 3 do
        pcall(function() Events.ToggleHotbar:InvokeServer(1) end)
        task.wait(0.7)
        if temVara() then return true end
    end
    return false
end

--------------------------------------------------------------------
-- LANCAR
--   Events.Fishing:FireServer(CFrame) - o servidor aceita o CFrame
--   que a gente manda (o boneco nem vira), mas valida se a boia cai
--   na agua. Se nao cair, ele cancela em ~0.6s.
--------------------------------------------------------------------
local function pescando()
    local c = char()
    return c and c:GetAttribute("Fishing") == true
end
local function recolher()
    if not pescando() then return end
    local h = hrp()
    if not h then return end
    pcall(function() Events.Fishing:FireServer(h.CFrame) end)
    for _ = 1, 20 do
        task.wait(0.15)
        if not pescando() then break end
    end
end
local function esperarCooldown()
    local c = char()
    for _ = 1, 25 do
        if not (c and c:GetAttribute("CDForTheNextThrow")) then return end
        task.wait(0.15)
    end
end
local function tentarAngulo(graus)
    local h = hrp()
    if not h then return false end
    esperarCooldown()
    pcall(function()
        Events.Fishing:FireServer(CFrame.new(h.Position) * CFrame.Angles(0, math.rad(graus), 0))
    end)
    S.lances = S.lances + 1
    task.wait(1.6)
    if pescando() then S.anguloBom = graus return true end
    return false
end
local function lancar()
    if S.anguloBom and tentarAngulo(S.anguloBom) then return true end
    S.anguloBom = nil
    S.estado = "procurando a agua"
    for g = 0, 315, 45 do
        if not souAtual() or not S.pescar then return false end
        if tentarAngulo(g) then return true end
    end
    return false
end

