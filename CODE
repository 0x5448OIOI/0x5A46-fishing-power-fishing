--   UseSkill:FireServer("Z"|"X"|"C"|"V").
--   So dispara se o slot estiver liberado (SkillSlot[slot] == true)
--   e o personagem nao estiver com SkillLocked. Sem isso vira
--   metralhadora de chamada recusada.
--------------------------------------------------------------------
local ultimaSkill = {}
local function slotLiberado(nome)
    local d = meusDados()
    local ss = d and d:FindFirstChild("SkillSlot")
    local s = ss and ss:FindFirstChild(nome)
    return s and s.Value == true
end
local function usarSkills()
    if not S.autoSkill then return end
    local c = char()
    if not c or c:GetAttribute("SkillLocked") == true then return end
    for _, nome in ipairs({ "Z", "X", "C", "V" }) do
        if S.skills[nome] and slotLiberado(nome) then
            local t = ultimaSkill[nome] or 0
            if os.clock() - t >= S.intervaloSkill then
                ultimaSkill[nome] = os.clock()
                pcall(function() Events.UseSkill:FireServer(nome) end)
                return -- uma por vez, pra nao empilhar
            end
        end
    end
end

