local pastaMarcas = new("Folder", { Name = "Marcas_0x5A46", Parent = RAIZ })
local MAX_CONTORNO = 22
local COR_JOG  = Color3.fromRGB(120, 200, 255)
local COR_VEND = Color3.fromRGB(255, 190, 90)
local marcas = {}

local function criarMarca(modelo, cor)
    local alvo = modelo:FindFirstChild("HumanoidRootPart")
        or modelo:FindFirstChild("Head") or modelo.PrimaryPart
        or modelo:FindFirstChildWhichIsA("BasePart")
    if not alvo then return nil end
    local bb = new("BillboardGui", {
        Adornee = alvo, Size = UDim2.fromOffset(210, 46),
        StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true,
        MaxDistance = 3000, LightInfluence = 0, Parent = pastaMarcas,
    })
    local txt = new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
        TextColor3 = cor, TextStrokeTransparency = 0.35,
        Font = Enum.Font.GothamBold, TextSize = 13, RichText = true, Parent = bb,
    })
    local m = { bb = bb, txt = txt, hl = nil, modelo = modelo, cor = cor }
    marcas[modelo] = m
    return m
end
local function contorno(m, ligado)
    if ligado and not m.hl then
        m.hl = new("Highlight", {
            Adornee = m.modelo, FillColor = m.cor, FillTransparency = 0.72,
            OutlineColor = m.cor, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
            Parent = pastaMarcas,
        })
    elseif not ligado and m.hl then
        pcall(function() m.hl:Destroy() end)
        m.hl = nil
    end
end
local function apagarMarca(modelo)
    local m = marcas[modelo]
    if not m then return end
    if m.hl then pcall(function() m.hl:Destroy() end) end
    pcall(function() m.bb:Destroy() end)
    marcas[modelo] = nil
end

-- le as varas que cada NPC vende
local function varasDoNPC(npc)
    local st = npc:FindFirstChild("Setting")
    if not st or not st:IsA("ModuleScript") then return nil end
    local ok, t = pcall(require, st)
    if not ok or type(t) ~= "table" then return nil end
    local l = {}
    for i = 1, 12 do
        local v = t[i]
        if type(v) == "string" then l[#l + 1] = v end
    end
    return #l > 0 and l or nil
end
local cacheVaras = {}

local function cicloESP()
    local h = hrp()
    if not h then return end
    local fila = {}
    if S.espJog then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local c = plr.Character
                local hum = c and c:FindFirstChildOfClass("Humanoid")
                if c and c.Parent and hum then
                    local ok, pos = pcall(function() return c:GetPivot().Position end)
                    if ok then
                        local d = (pos - h.Position).Magnitude
                        if d <= S.distESP then
                            fila[#fila + 1] = { m = c, d = d, cor = COR_JOG,
                                txt = ("%s\n<font size='11'>%d m</font>"):format(plr.Name, math.floor(d)) }
                        end
                    end
                end
            end
        end
    end
    if S.espVend then
        local npc = workspace:FindFirstChild("NPC")
        local pasta = npc and npc:FindFirstChild("BuyFishingRod")
        if pasta then
            for _, v in ipairs(pasta:GetChildren()) do
                if v:IsA("Model") then
                    local ok, pos = pcall(function() return v:GetPivot().Position end)
                    if ok then
                        local d = (pos - h.Position).Magnitude
                        if d <= S.distESP then
                            if cacheVaras[v] == nil then cacheVaras[v] = varasDoNPC(v) or false end
                            local lista = cacheVaras[v]
                            local corpo = lista and table.concat(lista, ", ") or "?"
                            fila[#fila + 1] = { m = v, d = d, cor = COR_VEND,
                                txt = ("VENDE VARA · %d m\n<font size='10'>%s</font>")
                                    :format(math.floor(d), corpo) }
                        end
                    end
                end
            end
        end
    end
    table.sort(fila, function(a, b) return a.d < b.d end)
    local vistos = {}
    for i, item in ipairs(fila) do
        vistos[item.m] = true
        local m = marcas[item.m]
        if not m or m.cor ~= item.cor then
            if m then apagarMarca(item.m) end
            m = criarMarca(item.m, item.cor)
        end
        if m then
            m.txt.Text = item.txt
            contorno(m, i <= MAX_CONTORNO)
        end
    end
    for modelo in pairs(marcas) do
        if not vistos[modelo] or not modelo.Parent then apagarMarca(modelo) end
    end
end

task.spawn(function()
    while souAtual() do
        task.wait(0.25)
        if S.espJog or S.espVend then pcall(cicloESP) end
    end
    for modelo in pairs(marcas) do apagarMarca(modelo) end
    pcall(function() pastaMarcas:Destroy() end)
end)

